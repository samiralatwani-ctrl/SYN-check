{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syn.app/schemas/label-extraction/v1.1.json",
  "title": "SYN label extraction (wire) v1.1",
  "description": "Compact schema the vision model fills (kept small so the structured-output grammar stays within limits). The server converts it to the internal LabelExtraction shape and enforces the invariants in packages/label-extraction (wire.ts, validate.ts). The model only transcribes; it never judges authenticity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image_quality_usable",
    "image_issues",
    "languages",
    "fields",
    "ingredients_status",
    "ingredients_text",
    "ingredients_truncated",
    "ingredients_confidence"
  ],
  "properties": {
    "image_quality_usable": {
      "type": "boolean"
    },
    "image_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "blur",
          "glare",
          "low_light",
          "cropped",
          "too_far",
          "angle",
          "batch_area_not_visible",
          "dates_not_visible",
          "ingredients_not_visible"
        ]
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ar",
          "en",
          "fr",
          "tr",
          "ku",
          "de",
          "it",
          "es",
          "ko",
          "other"
        ]
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_name",
        "product_name",
        "size",
        "concentration",
        "manufacturer_name",
        "batch",
        "manufacture_date",
        "expiry_date"
      ],
      "properties": {
        "brand_name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence",
            "unreadable_reason"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": "number"
            },
            "unreadable_reason": {
              "type": "string",
              "enum": [
                "none",
                "not_present",
                "not_visible",
                "blurred",
                "glare",
                "cropped",
                "ambiguous",
                "low_confidence"
              ],
              "description": "'none' when value is read."
            }
          }
        },
        "product_name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence",
            "unreadable_reason"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": "number"
            },
            "unreadable_reason": {
              "type": "string",
              "enum": [
                "none",
                "not_present",
                "not_visible",
                "blurred",
                "glare",
                "cropped",
                "ambiguous",
                "low_confidence"
              ],
              "description": "'none' when value is read."
            }
          }
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence",
            "unreadable_reason"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": "number"
            },
            "unreadable_reason": {
              "type": "string",
              "enum": [
                "none",
                "not_present",
                "not_visible",
                "blurred",
                "glare",
                "cropped",
                "ambiguous",
                "low_confidence"
              ],
              "description": "'none' when value is read."
            }
          },
          "description": "As printed, e.g. '50 ml' or '2 x 1 ml'."
        },
        "concentration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence",
            "unreadable_reason"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": "number"
            },
            "unreadable_reason": {
              "type": "string",
              "enum": [
                "none",
                "not_present",
                "not_visible",
                "blurred",
                "glare",
                "cropped",
                "ambiguous",
                "low_confidence"
              ],
              "description": "'none' when value is read."
            }
          },
          "description": "As printed, e.g. '24 mg/ml'."
        },
        "manufacturer_name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence",
            "unreadable_reason"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": "number"
            },
            "unreadable_reason": {
              "type": "string",
              "enum": [
                "none",
                "not_present",
                "not_visible",
                "blurred",
                "glare",
                "cropped",
                "ambiguous",
                "low_confidence"
              ],
              "description": "'none' when value is read."
            }
          }
        },
        "batch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence",
            "unreadable_reason",
            "ambiguous_positions"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": "number"
            },
            "unreadable_reason": {
              "type": "string",
              "enum": [
                "none",
                "not_present",
                "not_visible",
                "blurred",
                "glare",
                "cropped",
                "ambiguous",
                "low_confidence"
              ],
              "description": "'none' when value is read."
            },
            "ambiguous_positions": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "description": "0-based positions of characters that could be read two ways (O/0, I/1, S/5, B/8, Z/2)."
            }
          },
          "description": "Exact characters as printed (LOT / Batch / Seri No / رقم التشغيلة)."
        },
        "manufacture_date": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence",
            "unreadable_reason",
            "format_ambiguous"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": "number"
            },
            "unreadable_reason": {
              "type": "string",
              "enum": [
                "none",
                "not_present",
                "not_visible",
                "blurred",
                "glare",
                "cropped",
                "ambiguous",
                "low_confidence"
              ],
              "description": "'none' when value is read."
            },
            "format_ambiguous": {
              "type": "boolean"
            }
          },
          "description": "YYYY-MM-DD if the day is printed, YYYY-MM if only month and year. Null with reason 'ambiguous' if day/month order is unclear."
        },
        "expiry_date": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence",
            "unreadable_reason",
            "format_ambiguous"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": "number"
            },
            "unreadable_reason": {
              "type": "string",
              "enum": [
                "none",
                "not_present",
                "not_visible",
                "blurred",
                "glare",
                "cropped",
                "ambiguous",
                "low_confidence"
              ],
              "description": "'none' when value is read."
            },
            "format_ambiguous": {
              "type": "boolean"
            }
          },
          "description": "YYYY-MM-DD if the day is printed, YYYY-MM if only month and year. Null with reason 'ambiguous' if day/month order is unclear."
        }
      }
    },
    "ingredients_status": {
      "type": "string",
      "enum": [
        "read",
        "partially_read",
        "not_visible",
        "unreadable"
      ]
    },
    "ingredients_text": {
      "type": [
        "string",
        "null"
      ],
      "description": "The ingredient list exactly as printed, in order."
    },
    "ingredients_truncated": {
      "type": "boolean"
    },
    "ingredients_confidence": {
      "type": "number"
    }
  }
}