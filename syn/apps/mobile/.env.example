# Public (anon) Supabase values — safe to ship in the app; RLS + read-only RPCs protect the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# 1 = demo mode with TEST_ fixtures only (no network). Shows a visible "demo" banner.
EXPO_PUBLIC_SYN_FIXTURES=0
